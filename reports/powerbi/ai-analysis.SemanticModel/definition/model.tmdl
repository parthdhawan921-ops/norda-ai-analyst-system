model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation NORDA_BuiltBy = .claude/skills/powerbi/build_pbi.py

annotation PBI_QueryOrder = ["dim_channel", "dim_country", "dim_date", "dim_product", "fact_inventory", "fact_sales"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_channel
ref table dim_country
ref table dim_date
ref table dim_product
ref table fact_inventory
ref table fact_sales

ref cultureInfo en-US

