/// DIMENSION. One row per sales channel: web, app, marketplace.
table dim_channel
	lineageTag: 29efea76-b03f-5677-ab68-bb7b9ab77862

	/// Surrogate key. Joins to fact_sales. Hidden: plumbing.
	column channel_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 35c89aa1-8372-5162-b1bf-4612f2e9c391
		summarizeBy: none
		sourceColumn: channel_key

		annotation SummarizationSetBy = User

	/// web = own shop, app = NORDA app, marketplace = third-party platforms (no customer details).
	column channel_name
		dataType: string
		lineageTag: 937e55fc-de9a-5507-8e97-37e84e032882
		summarizeBy: none
		sourceColumn: channel_name

		annotation SummarizationSetBy = User

	partition dim_channel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Data Analytics\Baraa\Claude\claude linkedin\data\mart\dim_channel.csv"),[Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"channel_key", Int64.Type}, {"channel_name", type text}})
				in
				    #"Changed Type"

